<section class="section-dark" id="wizyta">
  <div class="section-dark-inner">
    {% set has_visit_info = post.meta('wizyta_address') or post.meta('wizyta_hours') or post.meta('wizyta_contact') or post.meta('wizyta_directions') or post.meta('wizyta_show_map') %}
    {% if has_visit_info %}
      <div class="visit-grid">
        <div class="visit-sidebar">
          <div class="visit-header reveal">
            <p class="section-label">{{ post.meta('wizyta_label') | default('Zaplanuj wizytę') }}</p>
            <h2 class="section-title section-title-dark">{{ post.meta('wizyta_title') | default('Odwiedź nas') | raw }}</h2>
          </div>
        <div class="visit-info reveal">
        {% if post.meta('wizyta_address') %}
          <div class="visit-block">
            <p class="visit-block-label">Adres</p>
            <p class="visit-block-text">{{ post.meta('wizyta_address') | raw }}</p>
          </div>
        {% endif %}
        {% if post.meta('wizyta_hours') %}
          <div class="visit-block">
            <p class="visit-block-label">Godziny otwarcia</p>
            <p class="visit-block-text">{{ post.meta('wizyta_hours') | raw }}</p>
            {% if post.meta('wizyta_hours_note') %}
              <p class="visit-block-text-small">{{ post.meta('wizyta_hours_note') }}</p>
            {% endif %}
          </div>
        {% endif %}
        {% if post.meta('wizyta_contact') %}
          <div class="visit-block">
            <p class="visit-block-label">Kontakt</p>
            <p class="visit-block-text">{{ post.meta('wizyta_contact') | raw }}</p>
          </div>
        {% endif %}
        {% if post.meta('wizyta_directions') %}
          <div class="visit-block">
            <p class="visit-block-label">Dojazd</p>
            <p class="visit-block-text">{{ post.meta('wizyta_directions') | raw }}</p>
            {% if post.meta('wizyta_directions_note') %}
              <p class="visit-block-text-small">{{ post.meta('wizyta_directions_note') }}</p>
            {% endif %}
          </div>
        {% endif %}
        </div>
        {% if post.meta('wizyta_show_map') %}
          <div class="visit-map reveal" role="region" aria-label="Mapa dojazdu do Winnicy Nowizny">
            <div class="visit-map-frame">
              {% if post.meta('wizyta_map_embed') %}
                {{ post.meta('wizyta_map_embed') | raw }}
              {% else %}
                <iframe
                  src="https://www.google.com/maps?q=Po%C5%82om+Ma%C5%82y+60%2C+32-862+Por%C4%85bka+Iwkowska&output=embed"
                  title="Winnica Nowizny — Połom Mały 60"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen>
                </iframe>
              {% endif %}
            </div>
          </div>
        {% endif %}
        </div>
    {% else %}
      <div class="visit-header reveal">
        <p class="section-label">{{ post.meta('wizyta_label') | default('Zaplanuj wizytę') }}</p>
        <h2 class="section-title section-title-dark">{{ post.meta('wizyta_title') | default('Odwiedź nas') | raw }}</h2>
      </div>
      <div class="visit-grid visit-grid-form-only">
    {% endif %}
      <div class="reveal reveal-delay-2">
        <div class="form-container">
          <h3 class="form-title">{{ post.meta('wizyta_form_title') | default('Rezerwacja') }}</h3>
          <p class="form-subtitle">{{ post.meta('wizyta_form_subtitle') | default('Wypełnij formularz, odezwiemy się w ciągu 24h') }}</p>
          {% if contact_status == 'success' %}
            <div class="form-notice form-notice-success" role="status">
              Dziękujemy! Wiadomość została zapisana. Odpowiemy najszybciej, jak to możliwe.
            </div>
          {% elseif contact_status in ['validation', 'security'] %}
            <div class="form-notice form-notice-error" role="alert">
              Sprawdź wymagane pola i spróbuj ponownie.
            </div>
          {% elseif contact_status == 'rate_limit' %}
            <div class="form-notice form-notice-error" role="alert">
              Wysłano zbyt wiele wiadomości. Spróbuj ponownie za kilkanaście minut.
            </div>
          {% elseif contact_status == 'error' %}
            <div class="form-notice form-notice-error" role="alert">
              Nie udało się zapisać wiadomości. Skontaktuj się z nami telefonicznie lub mailowo.
            </div>
          {% endif %}

          <form class="contact-form" action="{{ function('admin_url', 'admin-post.php') }}" method="post">
            <input type="hidden" name="action" value="winnica_contact">
            <input type="hidden" name="contact_started" value="{{ function('winnica_contact_token') }}">
            {{ function('wp_nonce_field', 'winnica_contact', 'winnica_contact_nonce', true, false) | raw }}

            <div class="form-honeypot" aria-hidden="true">
              <label for="contact-website">Strona internetowa</label>
              <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="contact-name">Imię i nazwisko *</label>
                <input class="form-input" id="contact-name" name="contact_name" type="text" autocomplete="name" minlength="2" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="contact-email">E-mail *</label>
                <input class="form-input" id="contact-email" name="contact_email" type="email" autocomplete="email" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="contact-phone">Telefon</label>
                <input class="form-input" id="contact-phone" name="contact_phone" type="tel" autocomplete="tel">
              </div>
              <div class="form-group">
                <label class="form-label" for="contact-topic">W czym możemy pomóc? *</label>
                <select class="form-input form-select" id="contact-topic" name="contact_topic" required>
                  <option value="degustacja">Degustacja</option>
                  <option value="grupa">Oferta dla grupy</option>
                  <option value="szkola">Szkoła lub przedszkole</option>
                  <option value="wydarzenie">Wydarzenie lub warsztaty</option>
                  <option value="inne">Inne pytanie</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-message">Wiadomość *</label>
              <textarea class="form-textarea" id="contact-message" name="contact_message" rows="6" minlength="10" required></textarea>
            </div>

            <label class="form-consent">
              <input type="checkbox" name="contact_consent" value="1" required>
              <span>Wyrażam zgodę na wykorzystanie podanych danych w celu odpowiedzi na wiadomość. Zapoznałem(-am) się z <a href="{{ function('get_privacy_policy_url') ?: function('home_url', '/polityka-prywatnosci/') }}">polityką prywatności</a>. *</span>
            </label>

            <button class="form-submit" type="submit">Wyślij wiadomość</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
