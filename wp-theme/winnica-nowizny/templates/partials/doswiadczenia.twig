<section class="section-dark" id="doswiadczenia" aria-labelledby="doswiadczenia-title">
  <div class="section-dark-inner">
    <div class="section-heading reveal">
      <p class="section-label">{{ post.meta('exp_label') | default('Doświadczenia') }}</p>
      <h2 id="doswiadczenia-title" class="section-title section-title-dark">{{ function('wp_kses_post', post.meta('exp_title') | default('Poczuj charakter winnicy')) | raw }}</h2>
    </div>
    <div class="exp-grid">
      {% set fallback_images = {
        1: {name: 'doswiadczenie-degustacja', w: 750, h: 1000, avif: true},
        2: {name: 'doswiadczenie-spacer', w: 750, h: 1000, avif: true, version: '20260729'},
        3: {name: 'doswiadczenie-daniele', w: 750, h: 1000, avif: true},
        4: {name: 'doswiadczenie-park-linowy', w: 675, h: 900, avif: true}
      } %}
      {% set exp_sizes = '(max-width: 360px) 96px, (max-width: 768px) 120px, (max-width: 1024px) 150px, 25vw' %}
      {% for i in 1..4 %}
        {% set title = post.meta('exp_card_' ~ i ~ '_title') %}
        {% if title %}
          <div class="exp-card reveal reveal-delay-{{ i }}">
            <div class="exp-card-image">
              {% set img = post.meta('exp_card_' ~ i ~ '_image') %}
              {% if img %}
                {{ function('wp_get_attachment_image', img.ID, 'gallery-square', false, {
                  'alt': title ~ ' w Winnicy Nowizny',
                  'loading': 'lazy',
                  'decoding': 'async',
                  'sizes': '(max-width: 360px) 96px, (max-width: 768px) 120px, (max-width: 1024px) 150px, 25vw'
                }) | raw }}
              {% else %}
                {% set fb = fallback_images[i] %}
                {% set img_base = theme.link ~ '/assets/images/' ~ fb.name %}
                {% set asset_version = fb.version ? '?v=' ~ fb.version : '' %}
                {% if fb.avif %}
                  <picture>
                    <source srcset="{{ img_base }}-240.avif 240w, {{ img_base }}-480.avif 480w, {{ img_base }}.avif {{ fb.w }}w" sizes="{{ exp_sizes }}" type="image/avif">
                {% endif %}
                  <img src="{{ img_base }}.webp{{ asset_version }}" srcset="{{ img_base }}-240.webp{{ asset_version }} 240w, {{ img_base }}-480.webp{{ asset_version }} 480w, {{ img_base }}.webp{{ asset_version }} {{ fb.w }}w" sizes="{{ exp_sizes }}" alt="{{ title }} w Winnicy Nowizny" width="{{ fb.w }}" height="{{ fb.h }}" loading="lazy" decoding="async">
                {% if fb.avif %}
                  </picture>
                {% endif %}
              {% endif %}
              <div class="exp-card-gradient"></div>
            </div>
            <div class="exp-card-body">
              <h3>{{ title }}</h3>
              <p>{{ post.meta('exp_card_' ~ i ~ '_desc') }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
