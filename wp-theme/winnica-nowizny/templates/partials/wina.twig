<section class="section-light wines" id="wina" aria-labelledby="wina-title">
  <div class="wines-header reveal">
    <div>
      <p class="section-label">{{ post.meta('wines_label') | default('Nasze wina') }}</p>
      <h2 id="wina-title" class="section-title section-title-light">{{ function('wp_kses_post', post.meta('wines_title') | default('Smak Pogórza')) | raw }}</h2>
    </div>
  </div>

  <ul class="wines-grid reveal" aria-label="Kolekcja win Winnicy Nowizny">
    {% for wine in wines %}
      <li class="wine-slide">
        <div class="wine-stage">
          {% if wine.thumbnail %}
            {{ function('wp_get_attachment_image', wine.thumbnail.id, 'bottle', false, {
              'alt': 'Butelka wina ' ~ wine.title ~ ' z Winnicy Nowizny',
              'class': 'wine-bottle-img',
              'sizes': '(max-width: 640px) 45vw, (max-width: 1023px) 30vw, 200px'
            }) | raw }}
          {% else %}
            <span class="wine-bottle-fallback" aria-hidden="true">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</span>
          {% endif %}
        </div>
        <div class="wine-info">
          {# Two wines share the title "Szpilówka" and only the type tells them apart.
             Carry the type into the heading so browsing by headings is not a guess,
             and hide the visible copy from readers to avoid saying it twice. #}
          {% set rodzaj = wine.meta('rodzaj') %}
          {% if rodzaj %}<p class="wine-type" aria-hidden="true">{{ rodzaj }}</p>{% endif %}
          <h3 class="wine-name">{{ wine.title }}{% if rodzaj %}<span class="sr-only">, {{ rodzaj }}</span>{% endif %}</h3>
          {% if wine.post_excerpt %}<p class="wine-desc">{{ wine.post_excerpt }}</p>{% endif %}
          {% set szczep = wine.meta('szczep') %}
          {% if szczep %}<p class="wine-grape"><span class="wine-grape-label">Szczep</span>{{ szczep }}</p>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>

  {# Sekcja konczyla sie piecioma butelkami i cisza. Pytanie "gdzie to kupic"
     pada tu samo, wiec odpowiedz stoi w tym samym miejscu, a nie dwie sekcje
     nizej w godzinach otwarcia. Gwiazdka jest w szablonie, a nie w polu ACF,
     zeby klient wpisywal sama tresc przypisu. #}
  {% if post.meta('wines_note') %}
    <p class="wines-note reveal">
      <span class="wines-note-mark" aria-hidden="true">*</span>{{ post.meta('wines_note') }}
    </p>
  {% endif %}
</section>
