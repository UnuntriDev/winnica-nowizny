<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero-bg">
    {% set bg = post.meta('hero_background_image') %}
    {% if bg %}
      {{ function('wp_get_attachment_image', bg.ID, 'hero-bg', false, {
        'class': 'hero-bg-img',
        'alt': 'Widok Winnicy Nowizny i Pogórza Rożnowskiego o zachodzie słońca',
        'loading': 'eager',
        'fetchpriority': 'high',
        'decoding': 'async',
        'sizes': '100vw'
      }) | raw }}
    {% else %}
      <picture>
        <source
          srcset="{{ function('esc_url', theme.link ~ '/assets/images/hero-winnica-768.avif') }} 768w, {{ function('esc_url', theme.link ~ '/assets/images/hero-winnica-1280.avif') }} 1280w, {{ function('esc_url', theme.link ~ '/assets/images/hero-winnica.avif') }} 1920w"
          sizes="100vw"
          type="image/avif">
        <img
          src="{{ function('esc_url', theme.link ~ '/assets/images/hero-winnica.webp') }}"
          srcset="{{ function('esc_url', theme.link ~ '/assets/images/hero-winnica-768.webp') }} 768w, {{ function('esc_url', theme.link ~ '/assets/images/hero-winnica-1280.webp') }} 1280w, {{ function('esc_url', theme.link ~ '/assets/images/hero-winnica.webp') }} 1920w"
          sizes="100vw"
          alt="Widok Winnicy Nowizny i Pogórza Rożnowskiego o zachodzie słońca"
          class="hero-bg-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async">
      </picture>
    {% endif %}
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    {# Bez ozdobnej kreski nad nadtytulem. Nad jednolitym tlem sekcji dziala, bo
       tlo jest przewidywalne; nad fotografia nieba dawala kontrast 1,3:1 i czytala
       sie jak smuga na zdjeciu, a nie jak swiadomy element. Sam nadtytul jest
       rozstrzelony i wersalikami, wiec zapowiada sie bez pomocy. #}
    {% if post.meta('hero_label') %}
      <p class="hero-label">{{ post.meta('hero_label') }}</p>
    {% endif %}
    <h1 id="hero-title">{{ function('wp_kses_post', post.meta('hero_title') | default('Winnica <br>Nowizny')) | raw }}</h1>
    {% if post.meta('hero_subtitle') %}
      <p class="hero-subtitle">{{ post.meta('hero_subtitle') }}</p>
    {% endif %}
    <div class="hero-buttons">
      {% if post.meta('hero_cta_primary_text') %}
        <a href="{{ function('esc_url', post.meta('hero_cta_primary_url') | default('#wizyta')) }}" class="btn-primary" data-mobile-cta-trigger>{{ post.meta('hero_cta_primary_text') }}</a>
      {% endif %}
      {% if post.meta('hero_cta_secondary_text') %}
        <a href="{{ function('esc_url', post.meta('hero_cta_secondary_url') | default('#wina')) }}" class="btn-text hero-cta-text">{{ post.meta('hero_cta_secondary_text') }}</a>
      {% endif %}
    </div>
  </div>

  <div class="scroll-indicator">
    <span>Odkryj</span>
    <div class="scroll-indicator-line"></div>
  </div>
</section>
