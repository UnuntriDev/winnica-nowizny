<section class="cellar" id="piwnica">
  <div class="cellar-bg"></div>
  <div class="cellar-inner">
    <div class="cellar-image reveal">
      {% set img = post.meta('cellar_image') %}
      {% if img %}
        {{ function('wp_get_attachment_image', img.ID, 'large', false, {
          'alt': 'Zabytkowa kamienna piwnica Winnicy Nowizny z 1891 roku',
          'loading': 'lazy',
          'decoding': 'async',
          'sizes': '(max-width: 768px) calc(100vw - 48px), 50vw'
        }) | raw }}
      {% else %}
        <picture>
          <source srcset="{{ theme.link }}/assets/images/piwnica-1891.avif" type="image/avif">
          <img src="{{ theme.link }}/assets/images/piwnica-1891.webp" alt="Zabytkowa kamienna piwnica Winnicy Nowizny z 1891 roku" width="1280" height="960" loading="lazy" decoding="async">
        </picture>
      {% endif %}
    </div>
    <div>
      <p class="cellar-year reveal">{{ post.meta('cellar_year') | default('1891') }}</p>
      <h2 class="reveal reveal-delay-1">{{ post.meta('cellar_title') | default('Piwnica z historią') | raw }}</h2>
      {% if post.meta('cellar_text_1') %}
        <p class="reveal reveal-delay-2">{{ post.meta('cellar_text_1') }}</p>
      {% endif %}
      {% if post.meta('cellar_text_2') %}
        <p class="reveal reveal-delay-2">{{ post.meta('cellar_text_2') }}</p>
      {% endif %}
      {% if post.meta('cellar_cta_text') %}
        <a href="{{ post.meta('cellar_cta_url') | default('#wizyta') }}" class="btn-outline-light reveal reveal-delay-3">{{ post.meta('cellar_cta_text') }}</a>
      {% endif %}
    </div>
  </div>
</section>
