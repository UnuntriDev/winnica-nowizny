<section class="cellar" id="piwnica" aria-labelledby="piwnica-title">
  <div class="cellar-bg"></div>
  <div class="cellar-inner">
    <div class="cellar-image reveal">
      {% set img = post.meta('cellar_image') %}
      {% if img %}
        {{ function('wp_get_attachment_image', img.ID, 'large', false, {
          'alt': 'Zabytkowa kamienna piwnica Winnicy Nowizny z 1891 roku',
          'loading': 'lazy',
          'decoding': 'async',
          'sizes': '(max-width: 768px) calc(100vw - 48px), 50vw'
        }) | raw }}
      {% else %}
        {% set cellar_sizes = '(max-width: 768px) calc(100vw - 48px), 50vw' %}
        <picture>
          <source srcset="{{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891-480.avif') }} 480w, {{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891-960.avif') }} 960w, {{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891.avif') }} 1280w" sizes="{{ cellar_sizes }}" type="image/avif">
          <img src="{{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891.webp') }}" srcset="{{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891-480.webp') }} 480w, {{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891-960.webp') }} 960w, {{ function('esc_url', theme.link ~ '/assets/images/piwnica-1891.webp') }} 1280w" sizes="{{ cellar_sizes }}" alt="Zabytkowa kamienna piwnica Winnicy Nowizny z 1891 roku" width="1280" height="1707" loading="lazy" decoding="async">
        </picture>
      {% endif %}
    </div>
    <div class="cellar-content">
      <p class="cellar-year reveal">{{ post.meta('cellar_year') | default('1891') }}</p>
      <h2 id="piwnica-title" class="reveal reveal-delay-1">{{ function('wp_kses_post', post.meta('cellar_title') | default('Piwnica z historią')) | raw }}</h2>
      {% if post.meta('cellar_text_1') %}
        <p class="reveal reveal-delay-2">{{ post.meta('cellar_text_1') }}</p>
      {% endif %}
      {% if post.meta('cellar_text_2') %}
        <p class="reveal reveal-delay-2">{{ post.meta('cellar_text_2') }}</p>
      {% endif %}
      {% if post.meta('cellar_cta_text') %}
        <a href="{{ function('esc_url', post.meta('cellar_cta_url') | default('#wizyta')) }}" class="btn-outline-light reveal reveal-delay-3">{{ post.meta('cellar_cta_text') }}</a>
      {% endif %}
    </div>
  </div>
</section>
