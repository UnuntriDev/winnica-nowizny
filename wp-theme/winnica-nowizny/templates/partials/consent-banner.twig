{% if analytics_id %}
  <div class="consent-widget" id="consent-widget" data-analytics-id="{{ analytics_id }}">
    <aside class="consent-panel" id="consent-panel" aria-labelledby="consent-title" aria-describedby="consent-description" aria-hidden="true" tabindex="-1" hidden>
      <div class="consent-panel-header">
        <p class="consent-title" id="consent-title">Szanujemy Twoją prywatność</p>
        <button class="consent-panel-control" type="button" data-consent-close aria-label="Zamknij panel cookies">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <p class="consent-copy" id="consent-description">Za Twoją zgodą używamy analitycznych plików cookie Google Analytics, aby ulepszać naszą stronę. Możesz je zaakceptować lub pozostać przy plikach cookie niezbędnych do jej działania.</p>
      <div class="consent-actions">
        <button type="button" data-consent="denied" aria-pressed="false">Tylko niezbędne</button>
        <button type="button" class="consent-accept" data-consent="granted" aria-pressed="false">Akceptuję</button>
      </div>
      <a class="consent-policy" href="{{ function('esc_url', function('get_privacy_policy_url') ?: function('home_url', '/polityka-prywatnosci/')) }}">Polityka prywatności</a>
    </aside>

    <button class="consent-toggle" type="button" data-open-consent data-consent-toggle aria-label="Otwórz ustawienia cookies" aria-controls="consent-panel" aria-expanded="false">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M9 4h14l-1.2 7.1a5.9 5.9 0 0 1-11.6 0L9 4Z"></path>
        <path d="M11 10h10M16 17v8M11.5 27h9"></path>
      </svg>
    </button>
  </div>
{% endif %}
