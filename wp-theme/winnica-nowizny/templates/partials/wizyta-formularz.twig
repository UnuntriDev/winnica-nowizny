{# Formularz rezerwacji. Wydzielony z wizyta.twig, bo obie galezie sekcji, ta
   z danymi kontaktowymi i ta bez nich, wstawiaja go w innym miejscu siatki. #}
<div class="visit-form reveal reveal-delay-2">
  <div class="form-container">
    <h3 class="form-title">{{ post.meta('wizyta_form_title') | default('Rezerwacja wizyty grupowej') }}</h3>
    <p class="form-subtitle">{{ post.meta('wizyta_form_subtitle') | default('Wypełnij formularz, odezwiemy się w ciągu 24h') }}</p>
    {% set old = contact_old | default({}) %}
    {% set errs = contact_errors | default([]) %}
    {% set error_messages = {
      'name': 'Podaj imię i nazwisko (od 2 do 100 znaków).',
      'email': 'Podaj poprawny adres e-mail.',
      'topic': 'Wybierz temat wiadomości.',
      'date': 'Podaj prawidłową datę od jutra do dwóch lat naprzód.',
      'guests': 'Podaj liczbę od 8 do 60 osób.',
      'message': 'Wiadomość musi mieć od 10 do 4000 znaków i maksymalnie dwa linki.',
      'consent': 'Zaznacz zgodę, aby wysłać wiadomość.'
    } %}
    {% if contact_status == 'success' %}
      <div class="form-notice form-notice-success" role="status">
        Dziękujemy! Wiadomość została zapisana. Odpowiemy najszybciej, jak to możliwe.
      </div>
    {% elseif contact_status in ['validation', 'security'] %}
      <div class="form-notice form-notice-error" role="alert">
        {% if errs %}
          Popraw zaznaczone pola. Pozostałe dane zostały zachowane.
        {% else %}
          Sprawdź wymagane pola i spróbuj ponownie.
        {% endif %}
      </div>
    {% elseif contact_status == 'rate_limit' %}
      <div class="form-notice form-notice-error" role="alert">
        Wysłano zbyt wiele wiadomości. Spróbuj ponownie za kilkanaście minut.
      </div>
    {% elseif contact_status == 'error' %}
      <div class="form-notice form-notice-error" role="alert">
        Nie udało się zapisać wiadomości. Skontaktuj się z nami telefonicznie lub mailowo.
      </div>
    {% endif %}

    <form class="contact-form" action="{{ function('esc_url', function('admin_url', 'admin-post.php')) }}" method="post">
      <input type="hidden" name="action" value="winnica_contact">
      <input type="hidden" name="contact_started" value="{{ old.started | default(function('winnica_contact_token')) }}">
      {{ function('wp_nonce_field', 'winnica_contact', 'winnica_contact_nonce', true, false) | raw }}

      <div class="form-honeypot" aria-hidden="true">
        <label for="contact-website">Strona internetowa</label>
        <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="contact-name">Imię i nazwisko *</label>
          <input class="form-input" id="contact-name" name="contact_name" type="text" value="{{ old.name | default('') }}" autocomplete="name" minlength="2" maxlength="100" required{% if 'name' in errs %} aria-invalid="true" aria-describedby="contact-name-error"{% endif %}>
          {% if 'name' in errs %}<span class="form-field-error" id="contact-name-error">{{ error_messages.name }}</span>{% endif %}
        </div>
        <div class="form-group">
          <label class="form-label" for="contact-email">E-mail *</label>
          <input class="form-input" id="contact-email" name="contact_email" type="email" value="{{ old.email | default('') }}" autocomplete="email" required{% if 'email' in errs %} aria-invalid="true" aria-describedby="contact-email-error"{% endif %}>
          {% if 'email' in errs %}<span class="form-field-error" id="contact-email-error">{{ error_messages.email }}</span>{% endif %}
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="contact-phone">Telefon</label>
          <input class="form-input" id="contact-phone" name="contact_phone" type="tel" value="{{ old.phone | default('') }}" autocomplete="tel">
        </div>
        <div class="form-group">
          <label class="form-label" for="contact-topic">W czym możemy pomóc? *</label>
          {% set topic = old.topic | default('') %}
          <select class="form-input form-select" id="contact-topic" name="contact_topic" required{% if 'topic' in errs %} aria-invalid="true" aria-describedby="contact-topic-error"{% endif %}>
            <option value="" disabled{% if not topic %} selected{% endif %}>Wybierz temat</option>
            {% for value, label in {
              'degustacja': 'Degustacja',
              'grupa': 'Oferta dla grupy',
              'szkola': 'Szkoła lub przedszkole',
              'wydarzenie': 'Wydarzenie lub warsztaty',
              'inne': 'Inne pytanie'
            } %}
              <option value="{{ value }}"{% if topic == value %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
          {% if 'topic' in errs %}<span class="form-field-error" id="contact-topic-error">{{ error_messages.topic }}</span>{% endif %}
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="contact-date">Preferowana data wizyty</label>
          {# Zwykly text, nie type="date": natywny picker rysuje sie w jezyku
             przegladarki, wiec na polskiej stronie potrafi pokazac 08/15/2026.
             Kalendarz dokleja datepicker.js, a bez JS wystarczy wpisac date. #}
          <div class="datepicker" data-datepicker>
            <input class="form-input" id="contact-date" name="contact_date" type="text" value="{{ old.date | default('') }}" placeholder="DD.MM.RRRR" inputmode="numeric" maxlength="10" autocomplete="off" aria-describedby="contact-date-format{% if 'date' in errs %} contact-date-error{% endif %}"{% if 'date' in errs %} aria-invalid="true"{% endif %}>
          </div>
          {# Placeholder niesie format dla patrzacych, ale znika po pierwszym
             znaku i czytniki ekranu go nie ogłaszają; ten opis zostaje. #}
          <span class="sr-only" id="contact-date-format">Format daty: dzień, miesiąc, rok, na przykład 15.08.2026</span>
          {% if 'date' in errs %}<span class="form-field-error" id="contact-date-error">{{ error_messages.date }}</span>{% endif %}
        </div>
        <div class="form-group">
          <label class="form-label" for="contact-guests">Liczba osób (grupy od 8)</label>
          <input class="form-input" id="contact-guests" name="contact_guests" type="number" value="{{ old.guests | default('') }}" inputmode="numeric" min="8" max="60"{% if 'guests' in errs %} aria-invalid="true" aria-describedby="contact-guests-error"{% endif %}>
          {% if 'guests' in errs %}<span class="form-field-error" id="contact-guests-error">{{ error_messages.guests }}</span>{% endif %}
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="contact-message">Wiadomość *</label>
        <textarea class="form-textarea" id="contact-message" name="contact_message" rows="6" minlength="10" maxlength="4000" required{% if 'message' in errs %} aria-invalid="true" aria-describedby="contact-message-error"{% endif %}>{{ old.message | default('') }}</textarea>
        {% if 'message' in errs %}<span class="form-field-error" id="contact-message-error">{{ error_messages.message }}</span>{% endif %}
      </div>

      <label class="form-consent{% if 'consent' in errs %} form-consent-error{% endif %}">
        <input type="checkbox" name="contact_consent" value="1" required{% if old.consent | default(false) %} checked{% endif %}{% if 'consent' in errs %} aria-invalid="true" aria-describedby="contact-consent-error"{% endif %}>
        <span>Wyrażam zgodę na wykorzystanie podanych danych w celu odpowiedzi na wiadomość. Zapoznałem(-am) się z <a href="{{ function('esc_url', function('get_privacy_policy_url') ?: function('home_url', '/polityka-prywatnosci/')) }}">polityką prywatności</a>. *</span>
      </label>
      {% if 'consent' in errs %}<span class="form-field-error form-field-error-consent" id="contact-consent-error">{{ error_messages.consent }}</span>{% endif %}

      <button class="form-submit" type="submit">Wyślij wiadomość</button>
    </form>
  </div>
</div>
