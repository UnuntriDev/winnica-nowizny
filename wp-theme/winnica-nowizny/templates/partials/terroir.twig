<section class="section-light" id="terroir">
  <div class="terroir-heading reveal">
    <p class="section-label">{{ post.meta('terroir_label') | default('Terroir') }}</p>
    <h2 class="section-title section-title-light">{{ post.meta('terroir_title') | default('Nasz terroir') | raw }}</h2>
  </div>
  <div class="terroir-grid">
    {% for i in 1..3 %}
      {% set title = post.meta('terroir_' ~ i ~ '_title') %}
      {% if title %}
        <div class="reveal reveal-delay-{{ i }}">
          <div class="terroir-icon" aria-hidden="true">
            {{ post.meta('terroir_' ~ i ~ '_icon') | raw }}
          </div>
          <h3 class="terroir-title">{{ title }}</h3>
          <p class="terroir-desc">{{ post.meta('terroir_' ~ i ~ '_desc') }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
