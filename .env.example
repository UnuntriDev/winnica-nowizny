# Produkcja — ustaw silne wartości i nie zapisuj pliku .env w repozytorium.
WORDPRESS_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
WP_ADMIN_PASSWORD=
WINNICA_WP_DEBUG=
WP_ENVIRONMENT_TYPE=production

# SMTP — uzupełnij danymi operatora poczty. Nie zapisuj prawdziwego hasła w repozytorium.
WINNICA_SMTP_HOST=
WINNICA_SMTP_PORT=587
WINNICA_SMTP_USER=
WINNICA_SMTP_PASS=
WINNICA_SMTP_ENCRYPTION=tls
WINNICA_SMTP_FROM_EMAIL=
WINNICA_SMTP_FROM_NAME=Winnica Nowizny

# Opcjonalnie: identyfikator Google Analytics 4, np. G-XXXXXXXXXX.
WINNICA_GA_ID=
